<?xml version="1.0" encoding="utf-8"?>
<!--
  MDI "flash" / lightning bolt, drawn on a 108x108 adaptive-icon canvas.
  Original 24x24 path "M7,2v11h3v9l7,-12h-4l4,-8z" scaled to 24..84 (offset 24)
  so the bolt sits inside the inner ~66dp safe zone of the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:fillColor="#00E676"
            android:pathData="M7,2v11h3v9l7,-12h-4l4,-8z" />
    </group>
</vector>
