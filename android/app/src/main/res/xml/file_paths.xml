<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Debug-report .txt files generated by Settings → Export debug log.
         Lives in the app's cache dir so it's transient and doesn't bloat
         user storage. -->
    <cache-path name="debug_reports" path="debug/" />
    <!-- LibreShock alarm-stop QR PNG, copied out of bundled drawables into
         cache so it can be shared via Intent.ACTION_SEND for printing. -->
    <cache-path name="qr_codes" path="qr/" />
</paths>
